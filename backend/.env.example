#############################################
# Backend Environment Variables (oldEnv example)
#############################################

# Application
# DEBUG enables verbose SQL logging and detailed error responses
DEBUG=true

# Database
# Use PostgreSQL in production/development:
# Format: postgresql+psycopg2://USERNAME:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/community_admin

# CORS origins (comma-separated list or JSON-style list)
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Clerk (Auth) keys - if applicable
# CLERK_SECRET_KEY=
# CLERK_PUBLISHABLE_KEY=

# Enable automatic publishing of short_form_roster.pdf to the IONOS website.
# Keep true in local dev if desired; generation still succeeds even if publish fails.
# Set true in AWS/test/prod only when the Secrets Manager secret exists.
ENABLE_IONOS_ROSTER_PUBLISH=false

# AWS Secrets Manager secret containing IONOS SFTP connection data.
# Do not put real credentials in this file.
IONOS_SFTP_SECRET_NAME=ionos-roster-sftp

# Optional AWS region for Secrets Manager lookup.
# AWS_REGION=us-east-1
