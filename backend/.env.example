#############################################
# Backend Environment Variables (.env example)
#############################################

# Application
# DEBUG enables verbose SQL logging and detailed error responses
DEBUG=true

# Database
# Use PostgreSQL in production/development:
# Format: postgresql+psycopg2://USERNAME:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/community_admin

# CORS origins (comma-separated list or JSON-style list)
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Clerk (Auth) keys - if applicable
# CLERK_SECRET_KEY=
# CLERK_PUBLISHABLE_KEY=
