# oldEnv.docker.example - Example environment variables for Docker deployment
# Copy this file to oldEnv and fill in your actual values

# Clerk Authentication
# Get these from https://dashboard.clerk.com
CLERK_SECRET_KEY=sk_test_your_secret_key_here
CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Database - PostgreSQL (required for all environments)
# Docker: uses service name 'db' as hostname
# Local: uses 'localhost' as hostname
DATABASE_URL=postgresql://clerk_user:clerk_password@db:5432/clerk_community_admin

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://frontend:3000

# AWS Configuration (for production deployment - optional for local dev)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
