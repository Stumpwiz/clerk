{
  "family": "clerk-combined",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::365591166807:role/clerk-ecs-execution-role",
  "taskRoleArn": "arn:aws:iam::365591166807:role/clerk-ecs-task-role",
  "containerDefinitions": [
    {
      "name": "nginx",
      "image": "365591166807.dkr.ecr.us-east-1.amazonaws.com/clerk-nginx:v0.2.0",
      "essential": true,
      "portMappings": [
        { "containerPort": 80, "protocol": "tcp" }
      ],
      "dependsOn": [
        {
          "containerName": "api",
          "condition": "HEALTHY"
        },
        {
          "containerName": "web",
          "condition": "HEALTHY"
        }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "wget --no-verbose --tries=1 --spider http://localhost/nginx-health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 10
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-region": "us-east-1",
          "awslogs-group": "/ecs/clerk-combined",
          "awslogs-stream-prefix": "nginx"
        }
      }
    },
    {
      "name": "api",
      "image": "365591166807.dkr.ecr.us-east-1.amazonaws.com/clerk-api:v0.1.9",
      "essential": true,
      "portMappings": [
        { "containerPort": 8000, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "DATABASE_URL", "value": "sqlite:////app/data/community_admin.db" },
        { "name": "XELATEX_PATH", "value": "xelatex" },
        { "name": "ALLOWED_ORIGINS", "value": "[\"*\"]" }
      ],
      "secrets": [
        { "name": "CLERK_PUBLISHABLE_KEY", "valueFrom": "arn:aws:secretsmanager:us-east-1:365591166807:secret:clerk/publishable-key-ZI9Obv" },
        { "name": "CLERK_SECRET_KEY", "valueFrom": "arn:aws:secretsmanager:us-east-1:365591166807:secret:clerk/secret-key-H4sxey" }
      ],
      "mountPoints": [
        { "sourceVolume": "efs", "containerPath": "/app/data", "readOnly": false },
        { "sourceVolume": "efs", "containerPath": "/app/files_letters", "readOnly": false },
        { "sourceVolume": "efs", "containerPath": "/app/files_roster_reports", "readOnly": false }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -fsS http://localhost:8000/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 20
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-region": "us-east-1",
          "awslogs-group": "/ecs/clerk-combined",
          "awslogs-stream-prefix": "api"
        }
      }
    },
    {
      "name": "web",
      "image": "365591166807.dkr.ecr.us-east-1.amazonaws.com/clerk-web:v0.1.9",
      "essential": true,
      "portMappings": [
        { "containerPort": 3000, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "NEXT_PUBLIC_API_BASE_URL", "value": "http://localhost:8000" },
        { "name": "API_INTERNAL_BASE_URL", "value": "http://localhost:8000" }
      ],
      "secrets": [
        { "name": "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY", "valueFrom": "arn:aws:secretsmanager:us-east-1:365591166807:secret:clerk/publishable-key-ZI9Obv" }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "wget -qO- http://localhost:3000/ >/dev/null 2>&1 || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 20
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-region": "us-east-1",
          "awslogs-group": "/ecs/clerk-combined",
          "awslogs-stream-prefix": "web"
        }
      }
    }
  ],
  "volumes": [
    {
      "name": "efs",
      "efsVolumeConfiguration": {
        "fileSystemId": "fs-0d3f870492feea6c5",
        "transitEncryption": "ENABLED",
        "rootDirectory": "/"
      }
    }
  ]
}
