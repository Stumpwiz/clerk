                    "valueFrom": "arn:aws:secretsmanager:us-east-1:365591166807:secret:clerk/secret-key-H4sxey"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/clerk-combined",
                    "awslogs-region": "us-east-1",
                    "awslogs-stream-prefix": "api"
                }
            },
            "healthCheck": {
                "command": [
                    "CMD-SHELL",
                    "curl -fsS http://localhost:8000/health || exit 1"
