# API .env example
# Copy to apps/api/.env and set secrets before starting containers

# Clerk (required)
CLERK_PUBLISHABLE_KEY=pk_...
CLERK_SECRET_KEY=sk_...

# Database (container default points to /app/data)
DATABASE_URL=sqlite:////app/data/community_admin.db

# XeLaTeX path inside container
XELATEX_PATH=xelatex

# Allowed Origins (CORS)
ALLOWED_ORIGINS=["http://localhost:3000"]

# Templates dir and PDF output dirs (defaults are fine)
# templates_dir=app/templates
# pdf_output_dir=files_letters
# roster_output_dir=files_roster_reports
